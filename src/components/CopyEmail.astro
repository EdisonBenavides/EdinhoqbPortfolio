<div class="email-row">
  <span class="email-label" aria-label="Email">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none"
      stroke="currentColor" stroke-width="2" stroke-linecap="round"
      stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="5" width="18" height="14" rx="2"></rect>
      <path d="m3 7 9 6 9-6"></path>
    </svg>
  </span>

  <code id="email-address">anbe2003@hotmail.com</code>
  <button class="copy-button" type="button" id="copy-email" aria-describedby="copy-status">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
  </button>
  <span class="sr-only" id="copy-status" aria-live="polite"></span>
</div>
<script>
  const button = document.querySelector<HTMLButtonElement>('#copy-email');
  const email = document.querySelector<HTMLElement>('#email-address');
  const status = document.querySelector<HTMLElement>('#copy-status');
  button?.addEventListener('click', async () => {
    if (!email) return;
    await navigator.clipboard.writeText(email.textContent?.trim() ?? '');

    button.classList.add('copied');
    
    if (status) status.textContent = 'Correo copiado al portapapeles.';

    window.setTimeout(() => {
      button.classList.remove("copied");
    }, 200);
  });
</script>
